{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "agent": {
    "default_profile": "write",
    "favorite_models": [],
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_model": {
      "enable_thinking": false,
      "provider": "ollama",
      "model": "gemma4:31b-cloud",
    },
  },
  "vim_mode": true,
  "ui_font_size": 17,
  "buffer_font_size": 15,
  "theme": {
    "mode": "light",
    "light": "One Dark",
    "dark": "Tokyo Night",
  },
  "buffer_font_features": {
    "calt": false,
  },
  "show_wrap_guides": true,
  "wrap_guides": [60, 80],
  "preferred_line_length": 80,
  "file_types": {
    "XML": ["svg"],
  },
}
