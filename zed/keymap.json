[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-b": "workspace::ToggleLeftDock",
      "cmd-t": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "tab": "editor::Indent",
      "alt-tab": "editor::AcceptEditPrediction",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-c": "terminal::Copy",
      "cmd-v": "terminal::Paste",
    },
  },
]
